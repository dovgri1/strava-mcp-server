# Required — get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret

# Obtain via the one-time auth flow: node scripts/auth.mjs
STRAVA_REFRESH_TOKEN=your_refresh_token

# Optional — cached access token (auto-managed by the server)
STRAVA_ACCESS_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=
